# ==============================================================================
# Happy Mind - Environment Configuration Template
# Duplicate this file to .env.local for local development.
# NEVER commit real secret keys into source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Companion Provider Configuration (Choose either Gemini or OpenAI)
# ------------------------------------------------------------------------------
# Recommended: Google Gemini (Get free key from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI (https://platform.openai.com)
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & PostgreSQL Database
# ------------------------------------------------------------------------------
# (Optional for local testing; without these, Happy Mind runs in Private Local Storage Mode)
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server-side service role key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. Optional Interventions Configuration
# ------------------------------------------------------------------------------
# Verified public calming ambient playlist (Peaceful Lo-fi / Ambient on Spotify)
NEXT_PUBLIC_TAKE_A_BREAK_URL=https://open.spotify.com/playlist/37i9dQZF1DX4sWSpwq3LiO
